{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 80,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "random",
  "sampler_params": {},
  "spaces": {
    "batch_sampler": {
      "choices": [
        "32:2",
        "64:2",
        "128:2",
        "256:2",
        "512:2"
      ],
      "type": "categorical"
    },
    "classifier_lr": {
      "high": 100.0,
      "log": true,
      "low": 0.0001,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.alpha": {
      "high": 100.0,
      "log": true,
      "low": 1,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.margin": {
      "high": 1.0,
      "log": false,
      "low": 0.01,
      "type": "float"
    },
    "lr": {
      "high": 0.0005,
      "log": true,
      "low": 1e-05,
      "type": "float"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "cifar",
  "timeout": null
}

{
  "backbone_tuning": "frozen",
  "cv_k": 1,
  "cv_mode": "group_kfold",
  "dataset": "CIFAR100",
  "dataset_protocol": "cifar100_fine_class_disjoint",
  "epochs": 1000,
  "feat_dim": 768,
  "final_test_after_hpo": true,
  "hparam_config": "configs/hpo/cifar/supervised_cir.json",
  "k_shot_grid": [
    600
  ],
  "label_budget_grid": [
    1
  ],
  "length_before_new_iter": 22800,
  "loss_miner_grid": [
    "CircleLoss:no_miner"
  ],
  "mode": "supervised",
  "patience": 8,
  "save_dir": "cifartest",
  "ssl_config": "configs/ssl_faiss_knn.json",
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "use_cache": true,
  "val_mode": "all"
}

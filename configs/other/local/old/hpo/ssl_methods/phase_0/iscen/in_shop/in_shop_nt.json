{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 50,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "random",
  "sampler_params": {},

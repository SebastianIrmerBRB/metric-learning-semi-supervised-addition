    "batch_sampler": {
      "choices": [
        "16:4",
        "32:4",
        "64:4",
        "128:4",
        "256:4",
        "512:4"
      ],
      "type": "categorical"
    },
    "classifier_lr": {
      "high": 100.0,
      "log": true,
      "low": 0.0001,
      "type": "float"
    },
    "loss.ArcFaceLoss.margin": {
      "high": 30.0,
      "log": true,
      "low": 15,
      "type": "float"
    },
    "loss.ArcFaceLoss.scale": {
      "high": 250.0,
      "log": true,
      "low": 40,
      "type": "float"
    },
    "loss.CircleLoss.gamma": {
      "high": 260.0,
      "log": true,
      "low": 50,
      "type": "float"
    },
    "loss.CircleLoss.m": {
      "high": 0.9,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.alpha": {
      "high": 25,
      "log": true,
      "low": 2,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.base": {
      "high": 0.9,
      "log": true,
      "low": 0.4,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.beta": {
      "high": 100,
      "log": true,
      "low": 40,
      "type": "float"
    },
    "loss.NTXentLoss.temperature": {
      "high": 0.5,
      "log": true,
      "low": 0.0001,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.margin": {
      "high": 1.0,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "lr": {
      "high": 1e-05,
      "log": true,
      "low": 1e-07,
      "type": "float"
    },
    "miner.MultiSimilarityMiner.epsilon": {
      "high": 0.8,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "ssl_config.confidence_threshold": {
      "high": 0.5,
      "log": false,
      "low": 0.5,
      "type": "float"
    },
    "ssl_config.labeled_batch_size": {
      "choices": [
        32,
        64
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.alpha": {
      "high": 0.99,
      "log": false,
      "low": 0.4,
      "type": "float"
    },
    "ssl_config.method_params.gamma": {
      "high": 8,
      "low": 1,
      "step": 1,
      "type": "float"
    },
    "ssl_config.method_params.n_neighbors": {
      "choices": [
        10,
        20,
        50,
        70
      ],
      "type": "categorical"
    },
    "ssl_config.warmup_epochs": {
      "high": 10,
      "low": 10,
      "step": 1,
      "type": "int"
    }

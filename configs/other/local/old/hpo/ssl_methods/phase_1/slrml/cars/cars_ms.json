{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 60,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "tpe",
  "sampler_params": {
    "group": true,
    "multivariate": true
  },
  "spaces": {
    "batch_sampler": {
      "choices": [
        "16:4",
        "32:4",
        "64:4",
        "128:4",
        "256:4",
        "512:8"
      ],
      "type": "categorical"
    },
    "loss.MultiSimilarityLoss.alpha": {
      "high": 25,
      "log": false,
      "low": 2,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.base": {
      "high": 0.9,
      "log": false,
      "low": 0.5,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.beta": {
      "high": 160,
      "log": true,
      "low": 40,
      "type": "float"
    },
    "lr": {
      "high": 0.0001,
      "log": true,
      "low": 8e-06,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.n_neighbors": {
      "choices": [
        3,
        6,
        10,
        15,
        25
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.regularizer_weight": {
      "high": 10,
      "log": true,
      "low": 0.001,
      "type": "float"
    },
    "ssl_config.method_params.supervised_weight": {
      "high": 2.0,
      "log": true,
      "low": 0.1,
      "type": "float"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "cars_imb_search",
  "timeout": null,
  "tpe_startup_trials": 20
}

{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 70,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "tpe",
  "sampler_params": {
    "multivariate": true
  },
  "spaces": {
    "batch_sampler": {
      "choices": [
        "32:4",
        "64:4",
        "128:4"
      ],
      "type": "categorical"
    },
    "loss.CircleLoss.gamma": {
      "high": 512.0,
      "log": true,
      "low": 32,
      "type": "float"
    },
    "loss.CircleLoss.m": {
      "high": 0.5,
      "log": false,
      "low": 0.01,
      "type": "float"
    },
    "lr": {
      "high": 0.0005,
      "log": true,
      "low": 1e-05,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.distance_scale": {
      "high": 16,
      "log": true,
      "low": 0.25,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.reference_sets": {
      "choices": [
        1,
        2
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.regularizer_weight": {
      "high": 100,
      "log": true,
      "low": 10,
      "type": "float"
    },
    "ssl_config.warmup_epochs": {
      "high": 30,
      "low": 0,
      "step": 5,
      "type": "int"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "cars_imb_search",
  "timeout": null,
  "tpe_startup_trials": 30
}

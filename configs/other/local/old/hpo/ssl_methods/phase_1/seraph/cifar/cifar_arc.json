{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 60,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "tpe",
  "sampler_params": {
    "group": true,
    "multivariate": true
  },
  "spaces": {
    "batch_sampler": {
      "choices": [
        "16:8",
        "32:8",
        "64:8",
        "128:8",
        "256:8",
        "512:16"
      ],
      "type": "categorical"
    },
    "classifier_lr": {
      "high": 10,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "loss.ArcFaceLoss.margin": {
      "high": 30.0,
      "log": false,
      "low": 15,
      "type": "float"
    },
    "loss.ArcFaceLoss.scale": {
      "high": 250.0,
      "log": true,
      "low": 40,
      "type": "float"
    },
    "lr": {
      "high": 0.0001,
      "log": true,
      "low": 1e-06,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.eta": {
      "high": 100,
      "log": true,
      "low": 0.001,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.temperature": {
      "high": 10.0,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "ssl_config.method_params.regularizer_params.unlabeled_ratio": {
      "choices": [
        0.25,
        0.5,
        1.0,
        2.0,
        3.0,
        4.0
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.regularizer_weight": {
      "high": 1,
      "log": true,
      "low": 1,
      "type": "float"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "cifar",
  "timeout": null,
  "tpe_startup_trials": 20
}

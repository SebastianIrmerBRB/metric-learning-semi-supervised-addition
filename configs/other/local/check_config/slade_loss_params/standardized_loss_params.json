{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_trials": 80,
  "pruner": "none",
  "pruner_params": {},
  "sampler": "tpe",
  "sampler_params": {
    "group": true,
    "multivariate": true
  },
  "spaces": {
    "classifier_lr": {
      "high": 10,
      "log": true,
      "low": 1e-05,
      "type": "float"
    },
    "loss.ArcFaceLoss.margin": {
      "high": 80.0,
      "log": false,
      "low": 1,
      "type": "float"
    },
    "loss.ArcFaceLoss.scale": {
      "high": 80.0,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "loss.CircleLoss.gamma": {
      "high": 512,
      "log": true,
      "low": 1,
      "type": "float"
    },
    "loss.CircleLoss.m": {
      "high": 0.5,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.alpha": {
      "high": 30,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.base": {
      "high": 0.9,
      "log": false,
      "low": 0.4,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.beta": {
      "high": 280,
      "log": true,
      "low": 1,
      "type": "float"
    },
    "loss.NTXentLoss.temperature": {
      "high": 0.4,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.alpha": {
      "high": 30.0,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.margin": {
      "high": 1.0,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "miner.MultiSimilarityMiner.epsilon": {
      "high": 0.99,
      "log": false,
      "low": 0.1,
      "type": "float"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "tpe_run",
  "timeout": null,
  "tpe_startup_trials": 40

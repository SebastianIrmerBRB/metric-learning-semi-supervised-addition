{
  "backbone_tuning": "frozen",
  "batch_size": 32,
  "cv_k": 4,
  "cv_mode": "group_kfold",
  "dataset": "Cars196",
  "dataset_protocol": "official",
  "epochs": 500,
  "evaluation_embedding_residency": "gpu",
  "feat_dim": 768,
  "final_test_after_hpo": false,
  "hparam_config": "configs/runs/slade/cars_teacher_student.json",
  "k_shot_grid": [
    16
  ],
  "label_budget_grid": [
    1
  ],
  "loss_miner_grid": [
    "ContrastiveLoss:no_miner"
  ],
  "lr": 3e-05,
  "mode": "ssl",
  "patience": 20,
  "sampler_m": 4,
  "save_dir": "runs/slade_cars_teacher_student",
  "ssl_config": "configs/runs/ssl/slade/paper_teacher_student.json",
  "ssl_gradient_contribution_log_interval": 30,
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "use_cache": true,
  "val_mode": "all"
}

{
  "extends": [
    "../semi_inat_2021.json",
    "standardized_ssl_params.json"
  ],
  "spaces": {
    "ssl_config.method_params.regularizer_params.graph_batch_size": {
      "choices": [
        16,
        32,
        64
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.regularizer_params.n_neighbors": {
      "high": 100,
      "log": false,
      "low": 2,
      "type": "int"
    },
    "ssl_config.method_params.regularizer_target_ratio": {
      "high": 1.25,
      "log": false,
      "low": 0.1,
      "type": "float"
    },
    "ssl_config.warmup_epochs": {
      "high": 10,
      "low": 0,
      "step": 2,
      "type": "int"
    }
  }
}

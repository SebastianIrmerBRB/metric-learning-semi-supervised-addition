{
  "backbone_tuning": "frozen",
  "batch_size": 256,
  "cv_k": 4,
  "cv_mode": "group_kfold",
  "dataset": "CIFAR100",
  "dataset_protocol": "cifar100_fine_class_disjoint",
  "epochs": 100,
  "feat_dim": 768,
  "final_test_after_hpo": false,
  "hparam_config": null,
  "k_shot_grid": [
    25
  ],
  "label_budget_grid": [
    1
  ],
  "loss_miner_grid": [
    "CircleLoss:no_miner"
  ],
  "lr": 1e-05,
  "mode": "supervised",
  "patience": 20,
  "sampler_m": 8,
  "save_dir": "cifar",
  "ssl_config": "configs/ssl_faiss_knn.json",
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "use_cache": true,
  "val_mode": "all"
}

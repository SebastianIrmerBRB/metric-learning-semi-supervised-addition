{
  "default_gpu_memory_mib": 1024,
  "device": "cpu",
  "gpu_batch_size_thresholds": [
    "TripletMarginLoss:all=99999",
    "NTXentLoss:all=0"
  ],
  "gpus": [
    0
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 10,
  "max_total_runs": 10,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 1024,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/local/configs/phase_1/cars/supervised.json",
      "hparam_config": "configs/used/originals/local/configs/runs/cars.json",
      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/used/originals/local/configs/phase_1/cars/supervised.json",
      "hparam_config": "configs/used/originals/local/configs/runs/cars.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/local/configs/phase_1/cars/supervised.json",
      "hparam_config": "configs/used/originals/local/configs/runs/cars.json",
      "name": "circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/local/configs/phase_1/cars/supervised.json",
      "hparam_config": "configs/used/originals/local/configs/runs/cars.json",
      "name": "arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/local/configs/phase_1/cars/supervised.json",
      "hparam_config": "configs/used/originals/local/configs/runs/cars.json",
      "name": "prx_loss"
    }
  ],
  "save_dir_root": "supervised/cars",
  "scheduler_log_dir": "logs/run_scheduler/cars_four_losses",
  "version": 1
}

{
  "default_gpu_memory_mib": 1024,
  "device": "cpu",
  "gpu_batch_size_thresholds": [
    "NTXentLoss:lrml=0",
    "CircleLoss:lrml=128",
    "ArcFaceLoss:lrml=128",
    "ProxyAnchorLoss:lrml=128",
    "MultiSimilarityLoss:lrml=128"
  ],
  "gpus": [
    0
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 10,
  "max_total_runs": 10,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 1024,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_ms.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_ms.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_ms.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_ms.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_ms.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "prx_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_nt.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "nt-xent1"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_nt.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "ms-loss1"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_nt.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "circle_loss1"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_nt.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "arc_loss1"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cub/cub_nt.json",
      "hparam_config": "configs/runs/first_run_cars_cub.json",
      "name": "prx_loss1"
    }
  ],
  "save_dir_root": "cub_supervised",
  "scheduler_log_dir": "logs/run_scheduler/cub_four_losses",

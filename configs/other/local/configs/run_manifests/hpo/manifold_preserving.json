{
  "default_gpu_memory_mib": 1024,
  "gpus": [
    0
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 10,
  "max_total_runs": 10,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 1024,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cars/manifold_preserving.json",
      "hparam_config": "configs/other/local/configs/runs/lrml/first/manifold_preserving.json",
      "name": "manifold_preserving_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cars/manifold_preserving.json",
      "hparam_config": "configs/other/local/configs/runs/lrml/first/manifold_preserving.json",
      "name": "manifold_preserving_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cars/manifold_preserving.json",
      "hparam_config": "configs/other/local/configs/runs/lrml/first/manifold_preserving.json",
      "name": "manifold_preserving_cir"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cars/manifold_preserving.json",
      "hparam_config": "configs/other/local/configs/runs/lrml/first/manifold_preserving.json",
      "name": "manifold_preserving_arc"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cars/manifold_preserving.json",
      "hparam_config": "configs/other/local/configs/runs/lrml/first/manifold_preserving.json",
      "name": "manifold_preserving_prx"
    }
  ],
  "save_dir_root": "ssl/cars/manifold_preserving",
  "scheduler_log_dir": "logs/run_scheduler/manifold_preserving",
  "version": 1
}

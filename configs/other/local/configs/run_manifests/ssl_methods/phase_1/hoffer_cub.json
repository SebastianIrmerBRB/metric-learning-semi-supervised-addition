{
  "default_gpu_memory_mib": 2048,
  "gpus": [
    0,
    1,
    2
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 4,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 4096,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/hoffer/cub/cub_nt.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/hoffer/cub/cub_nt.json",
      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/hoffer/cub/cub_ms.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/hoffer/cub/cub_ms.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/hoffer/cub/cub_cir.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/hoffer/cub/cub_cir.json",
      "name": "circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/hoffer/cub/cub_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/hoffer/cub/cub_arc.json",
      "name": "arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/hoffer/cub/cub_prx.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/hoffer/cub/cub_prx.json",
      "name": "prx_loss"
    }
  ],
  "save_dir_root": "scheduled/ssl_methods/phase_1/hoffer/cub",
  "scheduler_log_dir": "logs/run_scheduler/ssl_methods/phase_1/hoffer/cub",
  "version": 1
}

      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/cifar/supervised.json",
      "hparam_config": "configs/other/local/configs/runs/first/first_run_cifar.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"

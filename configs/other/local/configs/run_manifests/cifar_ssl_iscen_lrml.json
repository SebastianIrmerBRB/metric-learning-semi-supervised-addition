{
  "default_gpu_memory_mib": 1024,
  "device": "cpu",
  "gpus": [
    0,
    1
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 5,
  "max_total_runs": 10,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 1024,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/ssl_methods/lrml/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/lrml/cifar/cifar_nt.json",
      "name": "lrml_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/phase_1/ssl_methods/lrml/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/lrml/cifar/cifar_ms.json",
      "name": "lrml_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/ssl_methods/lrml/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/lrml/cifar/cifar_cir.json",
      "name": "lrml_cir"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/ssl_methods/lrml/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/lrml/cifar/cifar_arc.json",
      "name": "lrml_arc"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/ssl_methods/lrml/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/lrml/cifar/cifar_prx.json",
      "name": "lrml_prx"
    },
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/iscen/cifar/cifar_nt.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/iscen/cifar/cifar_prx.json",
      "name": "iscen_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/iscen/cifar/cifar_ms.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/iscen/cifar/cifar_prx.json",
      "name": "iscen_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/iscen/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/iscen/cifar/cifar_prx.json",
      "name": "iscen_cir"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/iscen/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/iscen/cifar/cifar_prx.json",
      "name": "iscen_arc"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/other/local/configs/phase_1/ssl_methods/iscen/cifar/cifar_prx.json",
      "hparam_config": "configs/hpo/ssl_methods/phase_1/iscen/cifar/cifar_prx.json",
      "name": "iscen_prx"
    }
  ],
  "save_dir_root": "ssl/cifar",
  "scheduler_log_dir": "logs/run_scheduler/cifar_four_losses",
  "version": 1
}

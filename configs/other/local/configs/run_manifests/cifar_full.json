{
  "default_gpu_memory_mib": 2048,
  "gpus": [
    0,
    1
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 4,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 4096,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_ms.json",
      "hparam_config": "configs/hpo/cifar/supervised_pair.json",
      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_ms.json",
      "hparam_config": "configs/hpo/cifar/supervised_ms.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_ms.json",
      "hparam_config": "configs/hpo/cifar/supervised_cir.json",
      "name": "circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_prx.json",
      "hparam_config": "configs/hpo/cifar/supervised_arc.json",
      "name": "arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_arc.json",
      "hparam_config": "configs/hpo/cifar/supervised_prx.json",
      "name": "prx_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/cifar/supervised_pair.json",
      "name": "nt-xent1",
      "save_dir": "scheduled/testing_phase_1_cifar/nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/cifar/supervised_ms.json",
      "name": "ms-loss1",
      "save_dir": "scheduled/testing_phase_1_cifar/ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/cifar/supervised_cir.json",
      "name": "circle_loss1",
      "save_dir": "scheduled/testing_phase_1_cifar/circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/cifar/supervised_arc.json",
      "name": "arc_loss1",
      "save_dir": "scheduled/testing_phase_1_cifar/arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/phase_1/cifar/cifar_cir.json",
      "hparam_config": "configs/hpo/cifar/supervised_prx.json",
      "name": "prx_loss1",
      "save_dir": "scheduled/testing_phase_1_cifar/prx_loss"
    }
  ],
  "save_dir_root": "scheduled/testing_phase_1_cifar",
  "scheduler_log_dir": "logs/run_scheduler/cifar_four_losses",
  "version": 1
}

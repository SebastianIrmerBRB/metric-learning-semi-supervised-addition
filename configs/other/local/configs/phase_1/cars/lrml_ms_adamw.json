  "mode": "ssl",
  "optim": "adamw",
  "patience": 20,
  "save_dir": "phase_1/ssl/cars/lrml_ms_adamw",
  "ssl_config": "configs/other/local/configs/ssl_methods/lrml_phase1_cars_ms.json",
  "ssl_gradient_contribution_log_interval": 30,
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "use_cache": true,
  "val_mode": "all"
}

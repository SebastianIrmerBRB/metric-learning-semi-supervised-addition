{
  "backbone_tuning": "frozen",
  "cv_k": 4,
  "cv_mode": "group_kfold",
  "cv_parallel_folds": 2,
  "dataset": "Cars196",
  "dataset_protocol": "official",
  "epochs": 600,
  "feat_dim": 768,
  "final_test_after_hpo": true,

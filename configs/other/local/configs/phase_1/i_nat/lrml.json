{
  "backbone_tuning": "frozen",
  "cv_k": 4,
  "cv_mode": "group_kfold",
  "dataset": "iNat",
  "dataset_protocol": "official",
  "epochs": 200,
  "feat_dim": 768,
  "final_test_after_hpo": true,
  "hparam_config": "configs/ssl/cars_lrml.json",
  "k_shot_grid": [
    8
  ],
  "label_budget_grid": [
    1
  ],
  "loss_miner_grid": [
    "ProxyAnchorLoss:no_miner"
  ],
  "mode": "ssl",
  "patience": 5,
  "save_dir": "iNatLrml",
  "ssl_config": "configs/ssl_regularized_lrml.json",
  "ssl_gradient_contribution_log_interval": 30,
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "use_cache": true,
  "val_mode": "all"
}

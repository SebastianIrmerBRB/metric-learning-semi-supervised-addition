{
  "direction": "maximize",
  "enabled": true,
  "load_if_exists": true,
  "metric": "best_valid_mean_average_precision_at_r",
  "n_jobs": 1,
  "n_trials": 80,
  "per_loss": {},
  "pruner": "none",
  "pruner_params": {},
  "retry_failed_trials": false,
  "sampler": "tpe",
  "sampler_params": {
    "group": true,
    "multivariate": true
  },
  "spaces": {
    "batch_sampler": {
      "choices": [
        "64:2",
        "128:2",
        "256:2",
        "512:2"
      ],
      "type": "categorical"
    },
    "loss.MultiSimilarityLoss.alpha": {
      "high": 30,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.base": {
      "high": 0.99,
      "log": false,
      "low": 0.4,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.beta": {
      "high": 280,
      "log": true,
      "low": 1,
      "type": "float"
    },
    "lr": {
      "high": 0.0005,
      "log": true,
      "low": 1e-05,
      "type": "float"
    },
    "miner.MultiSimilarityMiner.epsilon": {
      "high": 0.99,
      "log": false,
      "low": 0.1,
      "type": "float"
    }
  },
  "storage": null,
  "study_dir": null,
  "study_name": "tpe_run_supervised",
  "timeout": null,
  "tpe_startup_trials": 40
}

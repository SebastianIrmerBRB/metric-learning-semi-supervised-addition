      "name": "hoffer_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/cars/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/cars.json",
      "name": "hoffer_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/cars/hoffer.json",

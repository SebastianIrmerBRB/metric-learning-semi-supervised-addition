{
  "default_gpu_memory_mib": 1024,
  "gpus": [
    0,
    1,
    2,
    3
  ],
  "launch_delay_seconds": 3,
  "max_concurrent_per_gpu": 20,
  "max_total_runs": 20,
  "poll_interval_seconds": 3,

      "hparam_config": "configs/other/server/configs/runs/ssmlpc/cars.json",
      "name": "ssmlpc_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cars/ssmlpc.json",
      "hparam_config": "configs/other/server/configs/runs/ssmlpc/cars.json",
      "name": "ssmlpc_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cars/ssmlpc.json",
      "hparam_config": "configs/other/server/configs/runs/ssmlpc/cars.json",
      "name": "ssmlpc_cir"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cars/ssmlpc.json",
      "hparam_config": "configs/other/server/configs/runs/ssmlpc/cars.json",
      "name": "ssmlpc_arc"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cars/ssmlpc.json",
      "hparam_config": "configs/other/server/configs/runs/ssmlpc/cars.json",
      "name": "ssmlpc_prx"
    }
  ],
  "save_dir_root": "ssl/cars/ssmlpc_test",
  "scheduler_log_dir": "logs/run_scheduler/ssmlpc",

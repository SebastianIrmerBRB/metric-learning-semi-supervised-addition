{
  "default_gpu_memory_mib": 2048,
  "gpus": [
    2,
    3
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 20,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 4096,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/in_shop/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/in_shop.json",
      "name": "hoffer_nt"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/in_shop/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/in_shop.json",
      "name": "hoffer_ms"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/in_shop/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/in_shop.json",
      "name": "hoffer_cir"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/in_shop/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/in_shop.json",
      "name": "hoffer_arc"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/used/originals/server/configs/phase_1/in_shop/hoffer.json",
      "hparam_config": "configs/used/originals/server/configs/runs/hoffer/in_shop.json",
      "name": "hoffer_prx"
    }
  ],
  "save_dir_root": "phase_1/ssl/in_shop/hoffer",
  "scheduler_log_dir": "logs/run_scheduler/in_shop",
  "version": 1

{
  "default_gpu_memory_mib": 2048,
  "gpus": [
    0,
    1
  ],
  "launch_delay_seconds": 2,
  "max_concurrent_per_gpu": 10,
  "poll_interval_seconds": 2,
  "reserve_gpu_memory_mib": 4096,
  "runs": [
    {
      "args": [
        "--loss_miner_grid",
        "NTXentLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cifar/iscen.json",
      "hparam_config": "configs/other/server/configs/runs/iscen/first/cifar_initial.json",
      "name": "nt-xent"
    },
    {
      "args": [
        "--loss_miner_grid",
        "MultiSimilarityLoss:MultiSimilarityMiner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cifar/iscen.json",
      "hparam_config": "configs/other/server/configs/runs/iscen/first/cifar_initial.json",
      "name": "ms-loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "CircleLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cifar/iscen.json",
      "hparam_config": "configs/other/server/configs/runs/iscen/first/cifar_initial.json",
      "name": "circle_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ArcFaceLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cifar/iscen.json",
      "hparam_config": "configs/other/server/configs/runs/iscen/first/cifar_initial.json",
      "name": "arc_loss"
    },
    {
      "args": [
        "--loss_miner_grid",
        "ProxyAnchorLoss:no_miner"
      ],
      "experiment_config": "configs/other/server/configs/phase_1/cifar/iscen.json",
      "hparam_config": "configs/other/server/configs/runs/iscen/first/cifar_initial.json",
      "name": "prx_loss"
    }
  ],
  "save_dir_root": "cifar/iscen/first",
  "scheduler_log_dir": "logs/run_scheduler/cifar_iscen_first",
  "version": 1
}

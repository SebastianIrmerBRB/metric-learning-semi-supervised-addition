{
  "version": 1,
  "gpus": [0],
  "max_concurrent_per_gpu": 20,
  "default_gpu_memory_mib": 2048,
  "reserve_gpu_memory_mib": 4096,
  "poll_interval_seconds": 2,
  "launch_delay_seconds": 2,
  "save_dir_root": "semi_inat/supervised",
  "scheduler_log_dir": "logs/run_scheduler/in_shop_four_losses",
  "runs": [
     {
      "name": "nt-xent",
      "experiment_config": "configs/phase_1/semi_inat_2021/supervised.json",
      "hparam_config": "configs/runs/semi_inat_2021.json",
      "args": ["--loss_miner_grid", "NTXentLoss:no_miner"]
    },
     {
      "name": "ms-loss",
      "experiment_config": "configs/phase_1/semi_inat_2021/supervised.json",
      "hparam_config": "configs/runs/semi_inat_2021.json",
      "args": ["--loss_miner_grid", "MultiSimilarityLoss:MultiSimilarityMiner"]
    },
    {
      "name": "circle_loss",
      "experiment_config": "configs/phase_1/semi_inat_2021/supervised.json",
      "hparam_config": "configs/runs/semi_inat_2021.json",
      "args": ["--loss_miner_grid", "CircleLoss:no_miner"],

    },
     {
      "name": "arc_loss",
      "experiment_config": "configs/phase_1/semi_inat_2021/supervised.json",
      "hparam_config": "configs/runs/semi_inat_2021.json",
      "args": ["--loss_miner_grid", "ArcFaceLoss:no_miner"]
    },
    {
      "name": "prx_loss",
      "experiment_config": "configs/phase_1/semi_inat_2021/supervised.json",
      "hparam_config": "configs/runs/semi_inat_2021.json",
      "args": ["--loss_miner_grid", "ProxyAnchorLoss:no_miner"],

    }
  ]
}

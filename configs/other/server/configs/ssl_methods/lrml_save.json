{
  "confidence_threshold": 0.0,
  "embedding_batch_size": 256,
  "embedding_num_workers": 0,
  "label_sampling_mode": "global_budget",
  "labeled_fraction": 0.1,
  "labeled_per_class": null,
  "max_unlabeled_samples": null,
  "method": "regularized",
  "method_params": {
    "regularizer": "lrml",
    "regularizer_params": {
      "edge_weighting": "binary",
      "graph_on": "all",
      "n_neighbors": 6,
      "normalized_laplacian": true,
      "oracle_same_class_edges": false,
      "reduction": "mean"
    },
    "regularizer_target_ratio": 0.5,
    "regularizer_target_ratio_probe_memory": 10,
    "regularizer_target_ratio_update_interval_samples": 1000,
    "regularizer_weight": 0.01,
    "supervised_weight": 1.0
  },
  "restart_selection_after_warmup": true,
  "update_interval_epochs": 1,
  "update_mode": "every_n_epochs",
  "warmup_epochs": 1
}

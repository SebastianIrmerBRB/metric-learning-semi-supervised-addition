{
  "extends": [
    "../semi_inat_2021.json",
    "standardized_ssl_params.json"
  ],
  "spaces": {
    "ssl_config.method_params.regularizer_params.contrastive": {
      "choices": [
        true
      ],
      "type": "categorical"
    },
    "ssl_config.method_params.regularizer_params.contrastive_margin": {
      "high": 1.99,
      "log": true,
      "low": 0.1,
      "type": "float"
    },
    "ssl_config.warmup_epochs": {
      "high": 12,
      "low": 0,
      "step": 2,
      "type": "int"
    }
  }
}

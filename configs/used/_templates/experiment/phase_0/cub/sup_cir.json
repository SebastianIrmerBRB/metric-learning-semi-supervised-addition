{
  "compile_train_step": false,
  "extends": "common.json",
  "faiss_temp_memory_mb": 256,
  "final_fit_mode": "cross_validation_folds",
  "frozen_feature_cache_max_gb": 8096,
  "frozen_feature_residency_max_gb": 2.0,
  "hparam_config": "configs/used/phase_0/hpo/cub/sup_cir.json",
  "image_resize_mode": "squash",
  "loss": "CircleLoss",
  "measurements": [
    "precision_at_1",
    "mean_average_precision_at_r"
  ],
  "miner": "no_miner",
  "mode": "supervised",
  "save_dir": "thesis/phase_0/hpo/cub/sup_cir",
  "save_head_state": true,
  "ssl_config": "configs/used/phase_0/hpo_ssl/cub/sup_cir.json",
  "ssl_gradient_contribution_log_interval": 0,
  "warmup_loss": null,
  "warmup_miner": null
}

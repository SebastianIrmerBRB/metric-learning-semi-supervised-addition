{
  "batch_size": 16,
  "cv_k": 4,
  "dataset": "DeepFashionInShop",
  "dataset_protocol": "official",
  "evaluation_embedding_residency": "gpu",
  "extends": "../common.json",
  "faiss_temp_memory_mb": 256,
  "final_fit_mode": "cross_validation_folds",
  "final_test_visualization": [
    "pacmap"
  ],
  "frozen_feature_cache_max_gb": 8096,
  "frozen_feature_residency_max_gb": 2.0,
  "image_resize_mode": "squash",
  "lr": 1e-06,
  "measurements": [
    "precision_at_1",
    "mean_average_precision_at_r"
  ],
  "patience": 20,
  "save_head_state": false,
  "semi_inat_ood_fraction": 0,
  "validation_gallery_fraction": 0.5,
  "validation_retrieval_mode": "same_source",
  "warmup_miner": "no_miner"
}

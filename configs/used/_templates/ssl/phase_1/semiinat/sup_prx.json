{
  "confidence_threshold": 0.0,
  "embedding_batch_size": 256,
  "embedding_num_workers": 0,
  "extends": "common.json",
  "labeled_batch_size": null,
  "labeled_per_class": 16,
  "method": "regularized",
  "method_params": {
    "regularizer": "lrml",
    "regularizer_max_ratio": 3,
    "regularizer_params": {
      "edge_weighting": "binary",
      "graph_batch_size": 32,
      "graph_on": "all",
      "n_neighbors": 30,
      "normalized_laplacian": true,
      "reduction": "torch_sum"
    },
    "regularizer_target_ratio": 1,
    "regularizer_target_ratio_ema_alpha": 0.1,
    "regularizer_target_ratio_statistic": "max_mean",
    "regularizer_target_ratio_update_interval_samples": 1000,
    "regularizer_weight": 0.01,
    "supervised_weight": 1.0
  },
  "pseudo_label_diagnostics_mode": "save",
  "restart_selection_after_warmup": true,
  "seed": 7,
  "support_seed": 7,
  "update_interval_epochs": 1,
  "update_mode": "every_n_epochs",
  "warmup_epochs": 0
}

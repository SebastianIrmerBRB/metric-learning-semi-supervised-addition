{
  "confidence_threshold": 0.0,
  "embedding_batch_size": 32,
  "embedding_num_workers": 8,
  "extends": "common.json",
  "graph_diagnostics_layout": "tsne",
  "graph_edge_ablation": "off",
  "labeled_batch_size": null,
  "method": "regularized",
  "method_params": {
    "regularizer": "hoffer_entropy",
    "regularizer_params": {
      "reference_sets": 2,
      "unlabeled_batch_size": 128
    },
    "supervised_weight": 1.0
  },
  "pseudo_label_diagnostics_mode": "save",
  "pseudo_label_oracle_noise": 0.0,
  "pseudo_label_source": "method",
  "restart_selection_after_warmup": true,
  "seed": 2,
  "support_seed": 2,
  "update_interval_epochs": 1,
  "update_mode": "once"
}

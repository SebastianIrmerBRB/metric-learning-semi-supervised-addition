{
  "extends": "standardized_loss_params.json",
  "per_loss": {
    "ArcFaceLoss": {
      "spaces": {
        "lr": {
          "high": 0.0001,
          "log": true,
          "low": 5e-06,
          "type": "float"
        }
      }
    },
    "ProxyAnchorLoss": {
      "spaces": {
        "lr": {
          "high": 0.0001,
          "log": true,
          "low": 5e-06,
          "type": "float"
        }
      }
    }
  },
  "spaces": {
    "batch_sampler": {
      "choices": [
        "128:2",
        "256:2",
        "512:2"
      ],

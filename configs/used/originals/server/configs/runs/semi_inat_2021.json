      "log": true,
      "low": 1,
      "type": "float"
    },
    "loss.CircleLoss.m": {
      "high": 0.5,
      "log": true,
      "low": 0.01,
      "type": "float"
    },
    "loss.MultiSimilarityLoss.base": {
      "high": 0.7,
      "log": false,
      "low": 0.01,
      "type": "float"
    },
    "loss.NTXentLoss.temperature": {
      "high": 0.15,
      "log": true,
      "low": 0.005,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.alpha": {
      "high": 80.0,
      "log": true,
      "low": 1,
      "type": "float"
    },
    "loss.ProxyAnchorLoss.margin": {
      "high": 1.0,
      "log": false,
      "low": 0.01,
      "type": "float"
    },
    "lr": {
      "high": 0.0001,
      "log": true,
      "low": 5e-06,
      "type": "float"
    }
  }

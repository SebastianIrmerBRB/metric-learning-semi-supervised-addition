{
  "save_dir": "cifar_slrmml",
  "dataset": "CIFAR100",
  "length_before_new_iter": 22800,
  "dataset_protocol": "cifar100_fine_class_disjoint",
  "val_mode": "match_train",
  "cv_k": 1,
  "final_test_after_hpo": true,
  "cv_mode": "superclass_balanced_group_kfold",
  "mode": "ssl",
  "patience": 15,
  "epochs": 200,
  "ssl_config": "configs/ssl_regularized_slrmml.json",
  "hparam_config": "configs/ssl/cifar_slrmml.json",
  "label_budget_grid": [
    1
  ],
  "k_shot_grid": [
    25
  ],
  "ssl_label_sampling_modes": [
    "class_subset_k_shot"
  ],
  "loss_miner_grid": [
    "NTXentLoss:no_miner",
    "MultiSimilarityLoss:MultiSimilarityMiner",
    "CircleLoss:no_miner",
    "ArcFaceLoss:no_miner",
    "ProxyAnchorLoss:no_miner"
  ]
}
